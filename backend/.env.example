# ─── Required ─────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ─── Qdrant ───────────────────────────────────
# Local (Docker):
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Cloud (set QDRANT_URL to override host:port):
QDRANT_URL=
QDRANT_API_KEY=

# ─── Database ─────────────────────────────────
# SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./jadwachat.db
# PostgreSQL (prod):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/jadwachat

# ─── JWT Authentication ──────────────────────
# IMPORTANT: Set a stable secret in production!
JWT_SECRET_KEY=change-me-to-a-real-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Security ─────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://frontend1-production-13ce.up.railway.app,https://jadwa-chat.com
MAX_UPLOAD_SIZE_MB=50
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=10/minute

# ─── Models ───────────────────────────────────
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=3072
TEMPERATURE=0.1
